# Application Environment
APP_ENV=development
APP_NAME=GrowTube
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./data/growtube.db

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Worker Configuration
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2

# Google OAuth 2.0 / OpenID Connect (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Session Management & Security
SESSION_COOKIE_NAME=growtube_session
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_NAME=growtube_csrf
CSRF_SECRET=change-me-to-a-secure-csrf-secret-key-32-chars-minimum

# Optional YouTube Data API v3 (Separate from Google Sign-In)
YOUTUBE_API_KEY=

# AI Reasoning Engine: Local Ollama exclusively (qwen2.5:3b)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_MODEL=qwen2.5:3b
